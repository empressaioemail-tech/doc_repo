{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "node .cursor/hooks/seat-gate.mjs session"
      }
    ],
    "beforeShellExecution": [
      {
        "command": "node .cursor/hooks/seat-gate.mjs shell"
      }
    ],
    "preToolUse": [
      {
        "command": "node .cursor/hooks/seat-gate.mjs write",
        "matcher": "Write|StrReplace|Delete"
      }
    ]
  }
}
