# Normalize line endings to LF in the repo, check out native on Windows.
# Kills the CRLF phantom-dirty problem (autocrlf=true + no .gitattributes
# made committed files show as modified with a zero real diff).
* text=auto eol=lf

# Binary/asset types: never normalize.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.ico binary
*.woff binary
*.woff2 binary
*.zip binary
*.tgz binary
