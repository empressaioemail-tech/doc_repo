# Operator-local secrets (WorkOS keys, etc.). Never commit.
_secrets/

# Local-only material; never commit (name matches common mistake pattern)
Secrets.txt
debug.log

.claude/settings.local.json
.claude/state/
.claude/logs/

# MCP server starter code staged here pending migration to the hauska-mcp-server product repo.
# See CLAUDE.md "What is open" for the migration plan. Code is not strategy doc material; do not commit into doc_repo.
MCP Server/
# Stray full clone of the product repo left inside doc_repo; product code, not strategy. Do not commit; delete the clone.
hauska-mcp-server/

# Temp credential dumps staged for copy-into-extension; hold LIVE keys. Never commit. Delete after copy and rotate the key.
_temp_extension_hauska_key.md
_temp_*_key.md

# Local run scratch (codewarm/gate run logs, JSON, .mts drivers); regenerable, never doc material.
_temp/

# Probe and acquisition scripts run during active sessions; regenerable, never doc material.
_tmp_*

# Acquisition staging and QA screenshot artifacts; binary or ephemeral, not canonical.
_inbox/acquisition_staging/
_inbox/screenshots/

.vercel

# Confidential title / grading exemplars (Herbert DOTO/WI report, Winkler chains, any oil-and-gas or land title PDFs).
# NEVER commit: these are confidential third-party documents used only as internal grading exemplars,
# never redistributed, never copied into product repos. PDFs and title-document binaries are blocked repo-wide.
*.pdf
_title_exemplars_confidential/

# _scratch is Tier 2 fleet memory (90_runbooks/fleet_memory_practice.md).
# The markdown entries ARE the memory and are tracked. Everything else in there is
# working residue: scraped HTML, probe dumps, CSV matrices, one-off scripts. On
# 2026-08-20 a `git add _scratch/` swept 528 files and 208,108 lines toward a commit.
# Track the memory, ignore the residue.
_scratch/*
!_scratch/*.md
!_scratch/.gitkeep

# Operator-private material: meeting transcripts and anything carrying third-party personal
# information (health, family, financial history). doc_repo is PUBLIC on GitHub as of 2026-08-27.
# Nothing in here is ever committed, and nothing in here may be quoted verbatim into a tracked doc.
_private/

.vercel
.env*
