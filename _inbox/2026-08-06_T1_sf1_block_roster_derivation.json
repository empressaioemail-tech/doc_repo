  "derivationQuery": "\n-- T1 SF-1 block roster derivation (district store = txgio_parcel.zoning_district post-stamp47)\nSELECT\n  regexp_replace(p.prop_id::text, '^0+', '') AS prop_id,\n  p.situs_address,\n  split_part(coalesce(p.zoning_district, ''), ' ', 1) AS district_prefix,\n  (p.south_lat + p.north_lat) / 2.0 AS lat,\n  (p.west_lng + p.east_lng) / 2.0 AS lng\nFROM txgio_parcel p\nWHERE p.county_fips = '48021'\n  AND split_part(coalesce(p.zoning_district, ''), ' ', 1) = 'SF-1'\n  AND (p.south_lat + p.north_lat) / 2.0 >= 30.04\n  AND (p.south_lat + p.north_lat) / 2.0 <= 30.16\n  AND (p.west_lng + p.east_lng) / 2.0 >= -97.38\n  AND (p.west_lng + p.east_lng) / 2.0 <= -97.25\n  AND p.geometry IS NOT NULL\nORDER BY p.situs_address;\n",
