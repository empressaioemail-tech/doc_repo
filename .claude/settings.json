{
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Bash(git status)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git fetch:*)",
      "Bash(git branch:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push origin main)",
      "Bash(git push origin HEAD:main)",
      "Bash(git tag:*)",
      "Bash(git stash:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(tree:*)",
      "Bash(mkdir:*)",
      "Bash(touch:*)",
      "Bash(gh repo view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push:* --force*)",
      "Bash(git push:* -f*)",
      "Bash(git reset --hard*)",
      "Bash(git reset:* --hard*)",
      "Bash(git rebase:*)",
      "Bash(git checkout:* -B*)",
      "Bash(git branch -D*)",
      "Bash(git branch:* -D*)",
      "Bash(rm -rf*)",
      "Bash(rm:* -rf*)",
      "Bash(rm -fr*)",
      "Bash(rm:* -fr*)",
      "Bash(gh repo delete*)",
      "Bash(gh pr close:* --delete-branch*)",
      "Bash(git filter-repo:*)",
      "Bash(git filter-branch:*)",
      "Bash(npm publish:*)",
      "Bash(npx:* publish:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "if echo \"$CLAUDE_TOOL_INPUT\" | grep -qE 'git (commit|push)'; then BRANCH=$(git -C P:/doc_repo branch --show-current 2>/dev/null); if [ \"$BRANCH\" != \"main\" ] && [ -n \"$BRANCH\" ]; then echo '{\"block\": true, \"message\": \"git commit/push refused: current branch is '\"$BRANCH\"', not main. Switch to main explicitly or override.\"}' >&2; exit 2; fi; if [ -z \"$BRANCH\" ]; then echo '{\"block\": true, \"message\": \"git commit/push refused: detached HEAD. Check out a branch first.\"}' >&2; exit 2; fi; fi",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "env": {
    "EMPRESSA_DOC_REPO": "P:/doc_repo"
  }
}
